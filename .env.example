# Copy to .env and load with your process manager, or export manually.
# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Optional: comma-separated if you use a custom domain
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Required on Vercel — PostgreSQL (SQLite is read-only on serverless)
DATABASE_URL=
# Set to false only if your host rejects SSL (uncommon)
# DATABASE_SSL_REQUIRE=true
# DATABASE_SSL_REQUIRE=false

# Razorpay (optional — without keys, checkout uses COD)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp — pick one provider (or leave unset for console logging)
# WHATSAPP_PROVIDER=auto|meta|twilio|stub
WHATSAPP_PROVIDER=auto

# Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_API_VERSION=v21.0

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Referral discount on first order (%)
REFERRAL_DISCOUNT_PERCENT=5
