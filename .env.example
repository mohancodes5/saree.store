# Copy to .env and load with your process manager, or export manually.
# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Razorpay (optional — without keys, checkout uses COD)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp — pick one provider (or leave unset for console logging)
# WHATSAPP_PROVIDER=auto|meta|twilio|stub
WHATSAPP_PROVIDER=auto

# Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_API_VERSION=v21.0

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Referral discount on first order (%)
REFERRAL_DISCOUNT_PERCENT=5
